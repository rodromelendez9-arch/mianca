# Supabase (auth + base de datos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Libre (OAuth app para publicar en nombre del dealer)
# https://developers.mercadolibre.com.mx/
# El client id es público (se usa en el navegador para armar la URL de autorización).
# La redirect_uri debe coincidir EXACTO con la registrada en tu app de ML:
# <tu-dominio>/api/ml/callback
NEXT_PUBLIC_ML_CLIENT_ID=
NEXT_PUBLIC_ML_REDIRECT_URI=
ML_CLIENT_SECRET=

# Proveedor de IA multimodal para extraer specs de fotos/video
# y generar título/descripción del anuncio
ANTHROPIC_API_KEY=
